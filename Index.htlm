<!DOCTYPE html>
<html lang="fi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Purkukartta</title>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <style>
    body { margin: 0; font-family: Arial; }
    #map { height: 100vh; }
    .top {
      position: absolute;
      z-index: 999;
      background: white;
      padding: 10px;
      margin: 10px;
      border-radius: 8px;
    }
  </style>
</head>
<body>

<div class="top">
  Purkutuomion saaneet rakennukset
</div>

<div id="map"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const map = L.map('map').setView([64.9, 26.0], 5);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  attribution: '© OpenStreetMap'
}).addTo(map);

fetch("data.json")
  .then(res => res.json())
  .then(data => {

    data.forEach(item => {

      if (!item.location_hint) return;

      fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${item.location_hint}`)
        .then(res => res.json())
        .then(loc => {

          if (!loc.length) return;

          const lat = loc[0].lat;
          const lon = loc[0].lon;

          L.marker([lat, lon])
            .addTo(map)
            .bindPopup(`
              <b>${item.title || "Rakennus"}</b><br/>
              ${item.organization || ""}
            `);
        });
    });
  });
</script>

</body>
</html>
